{
  // Pengaturan Worker Foreverse.
  // File inilah yang membuat Cloudflare mengizinkan Bindings & Secrets.
  "name": "foreverse-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
