{
  "name": "foreverse-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/s/*", "/edit/*", "/perpanjang/*", "/r/*", "/kreator", "/ulang-tahun", "/anniversary", "/ldr", "/wisuda", "/surat-cinta", "/ajak-kencan", "/nyatakan-perasaan", "/cepat-sembuh", "/lamaran", "/minta-maaf", "/selamat", "/selesai-baik-baik", "/natal", "/tahun-baru", "/valentine", "/lebaran", "/api/*", "/f/*", "/template", "/momen", "/contoh", "/cara-pesan", "/harga", "/faq", "/developer", "/developer.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "foreverse-db", "database_id": "a2630269-5bd5-43a2-b032-ff57abdbd4d4" }
  ],
  "r2_buckets": [
    { "binding": "FOTO", "bucket_name": "foreverse-foto" }
  ],
  "triggers": { "crons": ["0 19 * * *", "*/15 * * * *"] },
  "observability": { "enabled": true },
  /* situs uji = Worker Previews: setiap push ke branch selain main membuat Preview
     dengan URL sendiri. Preview TIDAK memakai pengaturan produksi — semuanya dari blok ini:
     data & foto terpisah, email dialihkan ke pemilik, DOKU selalu Sandbox, tidak diindeks.
     Rahasia (kunci DOKU sandbox, Resend, sandi admin) diisi di dashboard: Settings →
     Variables and secrets → pilih "Previews Base". Cron tetap hanya jalan di produksi. */
  "previews": {
    "vars": { "STAGING": "1", "DOKU_MODE": "sandbox" },
    "d1_databases": [
      { "binding": "DB", "database_name": "foreverse-db-staging", "database_id": "bc467282-ab64-4b46-8c9d-66871157c8e7" }
    ],
    "r2_buckets": [
      { "binding": "FOTO", "bucket_name": "foreverse-foto-staging" }
    ]
  }
}
